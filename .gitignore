/pytest-sandbox-*/
/probe-*/
.test-tmp-*/

# Local reference/demo media not part of source release (design screenshots, videos)
/参考/

# Agent runtime state written into whatever directory it runs in
/.mp/

# Acceptance runs leave scratch profiles and intermediate workbooks behind.
# Keep the reported results, drop the browser caches and per-run temp copies.
data/acceptance-*/transcript-probe-profile/
data/acceptance-*/Cache/
data/acceptance-*/GPUCache/
