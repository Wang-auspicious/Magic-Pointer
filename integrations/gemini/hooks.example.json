{
  "hooks": {
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "magic-pointer-context",
            "type": "command",
            "command": "node",
            "args": [
              "MAGIC_POINTER_ROOT/build/electron/runtime/connectors.js",
              "hook",
              "--provider",
              "gemini",
              "--data-root",
              "D:/Desktop/Magic Pointer/data/runtime"
            ],
            "timeout": 5000,
            "description": "Inject a fresh frozen Magic Pointer object when the prompt refers to it."
          }
        ]
      }
    ]
  }
}
