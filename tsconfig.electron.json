{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "outDir": "build/electron",
    "rootDir": "electron",
    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts"],
  "exclude": [
    "electron/renderer/**",
    "electron/answer_shape_policy.ts",
    "electron/capture_proof_policy.ts",
    "electron/cards.ts",
    "electron/gesture_capture.ts",
    "electron/stage_anchor.ts",
    "electron/clarification_chips.ts",
    "electron/stage_chips_policy.ts",
    "electron/stage_hit_policy.ts",
    "electron/stage_pick_policy.ts",
    "electron/stage_state.ts",
    "electron/stage_stretch_policy.ts",
    "electron/stage_turn_stream.ts",
    "electron/voice_trigger_policy.ts",
    "electron/conversation_control.ts",
    "electron/slash_trigger.ts"
  ]
}
