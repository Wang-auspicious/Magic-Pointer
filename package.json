{
  "name": "magic-pointer",
  "version": "1.0.0",
  "description": "Magic Pointer Open - cross-platform AI pointer overlay",
  "main": "electron/main.js",
  "scripts": {
    "overlay": "electron electron/main.js",
    "pack:win": "node scripts/run-electron-builder.js --config electron-builder.yml --win --dir",
    "dist:win": "node scripts/run-electron-builder.js --config electron-builder.yml --win nsis",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_package.ps1",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_installer.ps1",
    "test": "node scripts/run-node-tests.js"
  },
  "keywords": [
    "ai-pointer",
    "overlay",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wang-auspicious/Magic-Pointer.git"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
