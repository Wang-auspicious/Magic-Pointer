{
  "name": "magic-pointer",
  "version": "1.0.12",
  "description": "Magic Pointer Open - cross-platform AI pointer overlay",
  "main": "build/electron/main.js",
  "scripts": {
    "build:electron": "tsx scripts/build-electron.ts",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.browser-globals.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "overlay": "npm run build:electron && electron .",
    "pack:win": "npm run build:electron && tsx scripts/run-electron-builder.ts --config electron-builder.yml --win --dir",
    "dist:win": "npm run build:electron && tsx scripts/run-electron-builder.ts --config electron-builder.yml --win nsis",
    "verify:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_package.ps1",
    "verify:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_installer.ps1",
    "verify:onboarding": "python scripts/verify_first_run_onboarding.py",
    "verify:n19": "python scripts/verify_n19_voice_triggers_desktop.py",
    "diag:collect": "tsx scripts/collect-diagnostics.ts",
    "model:groq": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure_groq.ps1",
    "model:status": "npm run build:electron && electron scripts/model_cli.js status",
    "model:test": "npm run build:electron && electron scripts/model_cli.js test",
    "test": "tsx scripts/run-node-tests.ts",
    "lint": "eslint electron scripts tests eslint.config.mjs --max-warnings=0",
    "lint:fix": "eslint electron scripts tests eslint.config.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync_install.ps1"
  },
  "keywords": [
    "ai-pointer",
    "overlay",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wang-auspicious/Magic-Pointer.git"
  },
  "bugs": {
    "url": "https://github.com/Wang-auspicious/Magic-Pointer/issues"
  },
  "homepage": "https://github.com/Wang-auspicious/Magic-Pointer#readme",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "semver": "^7.6.0"
  }
}
